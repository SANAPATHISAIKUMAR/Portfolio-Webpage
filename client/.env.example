# Copy to .env.local and fill in what you need. Every value here is optional —
# the site builds and runs without any of them.

# ---------------------------------------------------------------------------
# Public site origin
# ---------------------------------------------------------------------------
# Drives canonical URLs, the sitemap, robots.txt and Open Graph image URLs.
# Leave unset on Vercel: the production URL is detected automatically.
# Set this once you point a custom domain at the site.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# GitHub (live project stats)
# ---------------------------------------------------------------------------
# Without a token the site uses GitHub's unauthenticated limit of 60 requests
# per hour. Because fetching happens server-side and is cached for an hour,
# that is usually enough — but a token raises the ceiling to 5,000/hour and
# makes the live stats far more reliable.
# Create a fine-grained token with NO scopes (public read access is enough):
#   https://github.com/settings/tokens
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Free access key from https://web3forms.com — paste your email, get a key.
# Server-side only (no NEXT_PUBLIC_ prefix), so it never reaches the browser.
# Without it the contact form falls back to opening the visitor's mail client.
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
